# Local secrets and environments
.env
.venv/
venv/
.vscode/
.DS_Store

# Python build and cache files
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/
.ipynb_checkpoints/

# Dataset files are not redistributed with this repository.
data/raw/*
data/processed/*

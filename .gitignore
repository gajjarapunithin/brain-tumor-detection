# Training artifacts and model weights
experiments/*/checkpoints/
experiments/*/logs/
*.pth
*.pt
*.h5
*.ckpt

# Generated prediction files; keep the directory itself.
results/sample_predictions/*
!results/sample_predictions/.gitkeep
